# Copiar a .env.local y rellenar con los datos del proyecto Supabase.
# cp .env.example .env.local

SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PROJECT_REF=<project_ref>

# publishable = clave pública (cliente); secret = clave de servidor (se salta RLS).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
SUPABASE_SECRET_KEY=sb_secret_<...>
SUPABASE_ANON_KEY=sb_publishable_<...>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# Conexión para asyncpg. 5432 = directa (dev/migraciones), 6543 = pooler.
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@db.<project_ref>.supabase.co:5432/postgres
DATABASE_URL_ASYNCPG=postgresql://postgres:<DB_PASSWORD>@db.<project_ref>.supabase.co:5432/postgres

PGHOST=db.<project_ref>.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=<DB_PASSWORD>
