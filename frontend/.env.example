# Copiar a .env.local y rellenar con los datos del proyecto Supabase.
# cp .env.example .env.local

# Las dos van con NEXT_PUBLIC_ porque las usa el cliente del navegador.
# publishable = clave publica (la antigua anon). La RLS limita lo que lee.
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# API de planes (backend Python). Sin NEXT_PUBLIC_: solo se usan server-side desde
# los Server Actions, no llegan al navegador. El token es el secreto compartido.
NUTRIAPP_API_URL=https://<backend-host>
NUTRIAPP_API_TOKEN=<random_token>
